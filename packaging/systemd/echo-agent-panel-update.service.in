[Unit]
Description=Update EchoAgentPanel from its configured Git remote
Documentation=https://github.com/EchoLab-Auto/EchoAgentPanel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@SOURCE_DIR@
ExecStart="@UPDATE_SCRIPT@" --source "@SOURCE_DIR@" --binary "@BINARY@" --status "@STATUS_FILE@"
Environment="PATH=@SERVICE_PATH@"
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
