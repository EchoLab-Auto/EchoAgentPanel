[Unit]
Description=EchoAgentPanel Web UI Service
Documentation=https://github.com/EchoLab-Auto/EchoAgentPanel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 作用域相关的运行身份（system 作用域：User=/Group=/HOME；user 作用域：整行省略，
# 由该用户的 systemd --user 实例提供）。两条作用域都注入 ECHO_SERVICE_SCOPE，
# 脚本据此选择 `systemctl` / `systemctl --user`。
@SCOPE_LINES@
WorkingDirectory=@SOURCE_DIR@
ExecStart="@BINARY@" --config "@PANEL_CONFIG@" --static-dir "@STATIC_DIR@"
Environment="ECHO_UPDATE_STATUS_FILE=@STATUS_FILE@"
@SCOPE_ENV@
Environment="PATH=@SERVICE_PATH@"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
# user 作用域挂 default.target（由 linger 保证无人登录也常驻）；
# system 作用域挂 multi-user.target（开机即起，与会话无关）。
WantedBy=@WANTED_BY@
