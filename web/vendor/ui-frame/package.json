{
  "name": "@echolab-auto/ui-frame",
  "version": "1.2.0",
  "description": "Vue 3 新拟态 UI 组件库",
  "type": "module",
  "main": "./dist/ui-frame.umd.cjs",
  "module": "./dist/ui-frame.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/ui-frame.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/ui-frame.umd.cjs"
      }
    },
    "./doc": {
      "types": "./dist/doc/index.d.ts",
      "import": "./dist/doc/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "example": "vite --config examples/vite.config.ts --host",
    "example:build": "vite build --config examples/vite-build.config.ts",
    "example:preview": "vite preview --config examples/vite-build.config.ts --host",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.umd.config.ts && cp dist/index.d.ts dist/index.d.cts",
    "changeset": "changeset",
    "clean": "rm -rf dist dist-example",
    "docs:build": "echo '📚 文档位于 docs/ 目录。如需构建演示站点，请使用: npm run example:build'",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.vue --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:registry": "node scripts/check-component-registry.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "version": "changeset version && npm run format",
    "release": "npm run build && changeset publish --provenance --access public",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoLab-Auto/ui-frame.git"
  },
  "keywords": [
    "vue3",
    "vue",
    "ui",
    "component",
    "library",
    "neumorphism",
    "soft-ui",
    "design-system"
  ],
  "author": "EchoLab",
  "license": "MIT",
  "peerDependencies": {
    "dompurify": "^3.0.0",
    "marked": "^18.0.0",
    "mermaid": "^11.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "marked": {
      "optional": true
    },
    "dompurify": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.7",
    "marked": "^18.0.5",
    "prettier": "^3.8.3",
    "publint": "^0.3.22",
    "sass": "^1.69.0",
    "storybook": "^8.6.18",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.8",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
}
